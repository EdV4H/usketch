{
	"name": "@edv4h/usketch-css3d-renderer",
	"version": "0.0.0",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc --noEmit",
		"test": "vitest run --passWithNoTests",
		"clean": "rm -rf dist"
	},
	"dependencies": {
		"@edv4h/usketch-shared": "workspace:*"
	},
	"devDependencies": {
		"jsdom": "31.0.0",
		"typescript": "7.0.2",
		"vitest": "5.1.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist",
		"README.md"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/EdV4H/usketch.git",
		"directory": "packages/css3d-renderer"
	},
	"homepage": "https://github.com/EdV4H/usketch#readme",
	"bugs": {
		"url": "https://github.com/EdV4H/usketch/issues"
	},
