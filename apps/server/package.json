{
	"name": "@edv4h/usketch-server",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"main": "./dist/index.js",
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"dev": "wrangler dev",
		"typecheck": "tsc --noEmit",
		"test": "vitest run --passWithNoTests",
		"clean": "rm -rf dist",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "wrangler d1 migrations apply usketch-db --local"
	},
	"dependencies": {
		"@edv4h/usketch-plugin-server-ai": "workspace:*",
		"@edv4h/usketch-plugin-server-auth": "workspace:*",
		"@edv4h/usketch-plugin-server-boards": "workspace:*",
		"@edv4h/usketch-plugin-server-chat": "workspace:*",
		"@edv4h/usketch-plugin-server-comments": "workspace:*",
		"@edv4h/usketch-server-core": "workspace:*",
		"@edv4h/usketch-session-protocol": "workspace:*",
		"@edv4h/usketch-session-voting": "workspace:*",
		"@edv4h/usketch-shared": "workspace:*",
		"@edv4h/usketch-sync": "workspace:*",
		"@hono/zod-validator": "0.9.0",
		"better-auth": "1.6.26",
		"drizzle-orm": "0.45.2",
		"hono": "4.13.1",
		"yjs": "^13.6.0",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "5.20260810.1",
		"drizzle-kit": "0.31.10",
		"typescript": "7.0.2",
		"vitest": "4.1.10",
		"wrangler": "4.120.0"
	}
}
