---
import type { CollectionEntry } from "astro:content";
import { getCollection, render } from "astro:content";
import DocsLayout from "../../../layouts/DocsLayout.astro";

export async function getStaticPaths() {
	const entries = (await getCollection("docsJa")).filter((e) => e.id !== "index");
	return entries.map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}

interface Props {
	entry: CollectionEntry<"docsJa">;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const allEntries = (await getCollection("docsJa"))
	.filter((e) => e.id !== "index")
	.sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999));

const CHAPTER_DEFS: { label: string; prefix: string }[] = [
	{ label: "はじめる", prefix: "getting-started/" },
	{ label: "コアコンセプト", prefix: "concepts/" },
	{ label: "ガイド", prefix: "guides/" },
	{ label: "API リファレンス", prefix: "reference/" },
];

const chapters = CHAPTER_DEFS.map((def) => ({
	label: def.label,
	items: allEntries.filter((e) => e.id.startsWith(def.prefix)),
})).filter((c) => c.items.length > 0);

const flat = chapters.flatMap((c) => c.items);
const currentIndex = flat.findIndex((e) => e.id === entry.id);
const prev = currentIndex > 0 ? flat[currentIndex - 1] : undefined;
const next =
	currentIndex >= 0 && currentIndex < flat.length - 1 ? flat[currentIndex + 1] : undefined;
---

<DocsLayout entry={entry} chapters={chapters} headings={headings} prev={prev} next={next} locale="ja">
	<Content />
</DocsLayout>
