---
import { getCollection } from "astro:content";
import CatalogGrid from "../../components/plugins/catalog-grid";
import BaseLayout from "../../layouts/BaseLayout.astro";

const entries = await getCollection("plugins");
const plugins = entries.map((e) => e.data);

const CATEGORIES = [
	{ id: "shape", label: "Shapes", jpLabel: "シェイプ" },
	{ id: "tool", label: "Tools", jpLabel: "ツール" },
	{ id: "bg", label: "Background", jpLabel: "背景" },
	{ id: "ai", label: "AI", jpLabel: "AI" },
	{ id: "presence", label: "Presence", jpLabel: "プレゼンス" },
	{ id: "server", label: "Server", jpLabel: "サーバー" },
	{ id: "effect", label: "Effects", jpLabel: "エフェクト" },
	{ id: "ui", label: "UI / Utility", jpLabel: "UI / ユーティリティ" },
];

const basePath = import.meta.env.BASE_URL;
---

<BaseLayout title="Plugins" description="Browse uSketch plugins — shapes, tools, AI, presence and more." current="plugins">
	<div class="plugins-page">
		<header class="plugins-page__header">
			<h1>
				<span data-lang="en">Plugins</span>
				<span data-lang="jp">プラグイン</span>
			</h1>
			<p class="plugins-page__lead">
				<span data-lang="en">
					{plugins.length}+ plugins, one install away. Shapes, tools, AI, presence, server adapters, effects, and UI primitives.
				</span>
				<span data-lang="jp">
					{plugins.length}+ のプラグインを 1 コマンドで。シェイプ・ツール・AI・プレゼンス・サーバーアダプタ・エフェクト・UI プリミティブ。
				</span>
			</p>
		</header>
		<CatalogGrid client:load plugins={plugins} categories={CATEGORIES} basePath={basePath} />
	</div>
</BaseLayout>

<style>
	.plugins-page {
		max-width: 1200px;
		margin: 0 auto;
		padding: var(--space-12) var(--space-6) var(--space-16);
	}
	.plugins-page__header { margin-bottom: var(--space-8); }
	.plugins-page__header h1 {
		font-size: 48px;
		letter-spacing: -0.02em;
		font-weight: 700;
	}
	.plugins-page__lead {
		margin-top: var(--space-3);
		font-size: 17px;
		color: var(--fg-secondary);
		max-width: 640px;
	}
</style>
