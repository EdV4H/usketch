---
interface Props {
	category: string;
	glyph?: string;
	size?: number;
}

const { category, glyph, size = 48 } = Astro.props;

const bg: Record<string, string> = {
	shape: "linear-gradient(135deg, #8b5cf6 0%, #6d28d9 100%)",
	tool: "linear-gradient(135deg, #06b6d4 0%, #0891b2 100%)",
	bg: "linear-gradient(135deg, #10b981 0%, #047857 100%)",
	ai: "linear-gradient(135deg, #ec4899 0%, #8b5cf6 100%)",
	presence: "linear-gradient(135deg, #f59e0b 0%, #ef4444 100%)",
	server: "linear-gradient(135deg, #6366f1 0%, #4338ca 100%)",
	effect: "linear-gradient(135deg, #eab308 0%, #ec4899 100%)",
	ui: "linear-gradient(135deg, #64748b 0%, #334155 100%)",
};
---

<span
	class="plugin-glyph"
	style={`--size: ${size}px; background: ${bg[category] ?? bg.ui};`}
	aria-hidden="true"
>
	<span class="plugin-glyph__text">{(glyph ?? "••").toUpperCase().slice(0, 4)}</span>
</span>

<style>
	.plugin-glyph {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: var(--size);
		height: var(--size);
		border-radius: var(--r-md);
		box-shadow: 0 6px 18px rgba(0, 0, 0, 0.25), inset 0 1px 0 rgba(255, 255, 255, 0.18);
		color: white;
		font-family: var(--font-mono);
		font-weight: 600;
		font-size: calc(var(--size) * 0.28);
		letter-spacing: 0.03em;
		text-transform: uppercase;
		flex-shrink: 0;
	}
	.plugin-glyph__text {
		line-height: 1;
		padding: 0 2px;
		text-align: center;
	}
</style>
