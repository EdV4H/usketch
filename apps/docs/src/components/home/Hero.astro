---
import { href } from "../../lib/href";
---

<section class="hero u-grid-bg">
	<div class="hero__inner">
		<div class="hero__content">
			<span class="hero__pill">v1.2.0 · AI‑Native release</span>
			<h1 class="hero__title">
				Plugin-first
				<span class="u-grad-text">whiteboard</span>
				framework.
			</h1>
			<p class="hero__title-jp" data-lang="jp">プラグイン・ファーストのホワイトボード・フレームワーク。</p>
			<p class="hero__lead">
				Compose shapes, tools, AI, presence, and real-time sync from 50+ plugins — or ship your own.
				Everything in uSketch is a plugin, including the drawing layer itself.
			</p>
			<div class="hero__actions">
				<a class="hero__cta hero__cta--primary" href={href("/docs/getting-started/introduction/")}>Get started →</a>
				<a class="hero__cta hero__cta--ghost" href="https://github.com/EdV4H/usketch">View on GitHub</a>
			</div>
		</div>

		<div class="hero__canvas" aria-hidden="true">
			<svg viewBox="0 0 420 320" width="100%" height="100%">
				<defs>
					<linearGradient id="hg1" x1="0%" y1="0%" x2="100%" y2="100%">
						<stop offset="0%" stop-color="#8b5cf6" />
						<stop offset="100%" stop-color="#ec4899" />
					</linearGradient>
					<linearGradient id="hg2" x1="0%" y1="0%" x2="100%" y2="100%">
						<stop offset="0%" stop-color="#06b6d4" />
						<stop offset="100%" stop-color="#8b5cf6" />
					</linearGradient>
				</defs>

				<rect class="u-float-a" x="40" y="40" width="120" height="70" rx="10" fill="rgba(139, 92, 246, 0.18)" stroke="url(#hg1)" stroke-width="1.5" />
				<rect class="u-float-b" x="230" y="80" width="140" height="80" rx="10" fill="rgba(6, 182, 212, 0.14)" stroke="url(#hg2)" stroke-width="1.5" />
				<rect class="u-float-c" x="90" y="190" width="130" height="80" rx="10" fill="rgba(236, 72, 153, 0.18)" stroke="url(#hg1)" stroke-width="1.5" />

				<path class="u-arrow" d="M160 75 L230 120" stroke="url(#hg2)" stroke-width="2" fill="none" stroke-linecap="round" />
				<path class="u-arrow" d="M300 160 L220 210" stroke="url(#hg1)" stroke-width="2" fill="none" stroke-linecap="round" />

				<path class="u-ghost" d="M30 300 Q 200 280 400 310" stroke="rgba(255,255,255,0.35)" stroke-width="1.5" fill="none" stroke-dasharray="6 4" />

				<g class="u-cursor u-cursor--violet" transform="translate(170 120)">
					<path d="M0 0 L12 4 L5 6 L3 14 Z" fill="#8b5cf6" />
				</g>
				<g class="u-cursor u-cursor--cyan" transform="translate(270 200)">
					<path d="M0 0 L12 4 L5 6 L3 14 Z" fill="#06b6d4" />
				</g>
			</svg>
		</div>
	</div>
</section>

<style>
	.hero {
		position: relative;
		overflow: hidden;
		background-color: var(--bg-canvas);
	}
	.hero::before {
		content: "";
		position: absolute;
		inset: 0;
		background: radial-gradient(ellipse at 60% 40%, rgba(139, 92, 246, 0.35), transparent 60%);
		pointer-events: none;
	}
	.hero__inner {
		position: relative;
		max-width: 1400px;
		margin: 0 auto;
		padding: var(--space-16) var(--space-6) var(--space-20);
		display: grid;
		grid-template-columns: 1.1fr 1fr;
		gap: var(--space-12);
		align-items: center;
	}
	.hero__content { max-width: 620px; }
	.hero__pill {
		display: inline-block;
		padding: 6px 12px;
		border-radius: var(--r-pill);
		font-size: 11px;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		background: var(--brand-gradient-soft);
		color: var(--fg-primary);
		margin-bottom: var(--space-4);
	}
	.hero__title {
		font-size: 68px;
		line-height: 1.04;
		letter-spacing: -0.02em;
		font-weight: 700;
		margin: 0 0 var(--space-2);
	}
	.hero__title-jp {
		font-size: 22px;
		color: var(--fg-secondary);
		margin-top: var(--space-2);
	}
	.hero__lead {
		font-size: 17px;
		line-height: 1.6;
		color: var(--fg-secondary);
		margin-top: var(--space-5);
	}
	.hero__actions {
		display: inline-flex;
		gap: var(--space-3);
		margin-top: var(--space-7);
	}
	.hero__cta {
		display: inline-flex;
		align-items: center;
		height: 48px;
		padding: 0 22px;
		border-radius: var(--r-md);
		font-weight: 600;
		font-size: 14.5px;
		transition: transform var(--dur-fast) var(--ease-out), box-shadow var(--dur-fast) var(--ease-out);
	}
	.hero__cta--primary {
		background: var(--brand-gradient);
		color: white;
	}
	.hero__cta--primary:hover {
		transform: translateY(-1px);
		box-shadow: var(--shadow-glow);
	}
	.hero__cta--ghost {
		border: 1px solid var(--border-default);
		color: var(--fg-primary);
	}
	.hero__cta--ghost:hover { background: var(--bg-hover); }

	.hero__canvas {
		filter: drop-shadow(0 20px 50px rgba(139, 92, 246, 0.25));
	}

	.u-float-a { animation: u-fade-in 600ms var(--ease-out) 120ms backwards; }
	.u-float-b { animation: u-fade-in 600ms var(--ease-out) 260ms backwards; }
	.u-float-c { animation: u-fade-in 600ms var(--ease-out) 400ms backwards; }
	.u-arrow {
		stroke-dasharray: 120;
		stroke-dashoffset: 120;
		animation: u-draw 900ms var(--ease-out) 600ms forwards;
	}
	.u-ghost {
		animation: u-ghost-dash 2.4s linear infinite;
	}
	.u-cursor { animation: u-cursor-wiggle 4s var(--ease-in-out) infinite; }
	.u-cursor--cyan { animation-delay: 1.2s; }

	@keyframes u-draw {
		to { stroke-dashoffset: 0; }
	}

	@media (max-width: 980px) {
		.hero__inner { grid-template-columns: 1fr; padding: var(--space-12) var(--space-6); }
		.hero__title { font-size: 48px; }
		.hero__canvas { max-width: 480px; margin: 0 auto; }
	}
</style>
