{
	"$schema": "https://biomejs.dev/schemas/2.5.3/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"a11y": {
				"noSvgWithoutTitle": "off"
			},
			"complexity": {
				"noImportantStyles": "off"
			},
			"correctness": {
				"noUnsafeOptionalChaining": "warn",
				"noInnerDeclarations": "warn"
			},
			"suspicious": {
				"noArrayIndexKey": "warn"
			}
		}
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 100
	},
	"files": {
		"includes": ["apps/**", "packages/**", "plugins/**", "biome.json", "turbo.json", "!**/*.astro"],
		"experimentalScannerIgnores": ["**/dist/**", "**/node_modules/**"]
	}
}
