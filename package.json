		"clean": "turbo run clean",
		"prepare": "prek install"
	},
	"devDependencies": {
		"@biomejs/biome": "2.2.3",
		"@j178/prek": "0.3.8",
		"turbo": "2.8.20",
		"typescript": "5.9.3"
	}
}
