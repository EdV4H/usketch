{
	"name": "@edv4h/usketch",
	"version": "0.0.0",
	"private": true,
	"description": "Real-time collaborative whiteboard application",
	"license": "ISC",
	"packageManager": "pnpm@10.32.1",
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"test": "turbo run test",
		"lint": "biome check .",
